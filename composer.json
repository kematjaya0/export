{
    "name": "kematjaya/export",
    "description": "Export library for Symfony",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "dompdf/dompdf": "^3.1",
        "ticketpark/htmlphpexcel": "^2.2",
        "symfony/http-foundation": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/serializer": "^7.4",
        "phpoffice/phpspreadsheet": "^5.3",
        "symfony/dom-crawler": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/mime": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.4",
        "friendsofphp/php-cs-fixer": "^3.64",
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.1",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\Export\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\Export\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text --coverage-filter src",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "rector-dry": "rector process --dry-run"
    }
}
